# ==============================================================================
# UK Wind Power Dashboard - Environment Variables Configuration
# ==============================================================================
# Set these variables in your Vercel Dashboard under:
# Project Settings -> Environment Variables
# ==============================================================================

# 1. Elexon BMRS Insights API Key (Optional)
# The modern Elexon BMRS Insights Solution API is free and open access,
# so the dashboard works out-of-the-box without any key.
# However, if you have an Elexon portal / developer subscription key, add it here:
ELEXON_API_KEY=
# Supported aliases:
# BMRS_API_KEY=
# API_KEY=

# 2. Application API Key (Optional)
# If you want to protect your dashboard's backend endpoints (/api/*),
# define a secret key here. Any request without a matching key in the
# 'x-api-key' header or 'Authorization: Bearer <key>' will be rejected (401).
# Leave empty to allow open access.
APP_API_KEY=

# 3. Frontend App API Key (Optional)
# Required only if APP_API_KEY is enabled above. Vite injects this during build
# so the React frontend sends the 'x-api-key' header automatically.
VITE_APP_API_KEY=

# 4. Frontend Custom Backend API URL (Optional)
# Only required if your frontend and backend are hosted on separate domains.
# If hosted together on Vercel, leave this empty (it defaults to the current domain).
VITE_API_URL=

# 5. Local Development Server Port (Optional)
PORT=5000
